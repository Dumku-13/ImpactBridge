# Copy this file to `.env` and fill in values. `.env` is gitignored.

# --- Database (matches docker-compose.yml; note host port 5433) ---
DATABASE_URL="postgresql://impactbridge:impactbridge@localhost:5433/impactbridge?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the web app in dev)
CORS_ORIGIN="http://localhost:5173"

# --- Auth ---
# Generate strong values with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-in-production-0000000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-in-production-1111111111"

# Base URL of the web app, used to build links inside emails
WEB_APP_URL="http://localhost:5173"

# Base URL of this API, used to build gateway redirect targets
API_PUBLIC_URL="http://localhost:4000"

# --- Payments ---
# Leave PAYMENT_PROVIDER unset to auto-select: Razorpay when the keys below are
# present, otherwise the built-in mock gateway. Set it explicitly to force one
# (e.g. PAYMENT_PROVIDER=mock to demo offline even with real keys configured).
# PAYMENT_PROVIDER="razorpay"

# Razorpay — TEST keys only (rzp_test_…). The server refuses to start on a live key.
# Get them at https://dashboard.razorpay.com/app/keys with the dashboard in Test Mode.
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."

# Only needed to receive real webhooks (requires a public URL / tunnel).
# Donations still confirm without it via server-side verification.
# RAZORPAY_WEBHOOK_SECRET="..."

# ISO currency code used for every amount on the platform. Amounts are always
# stored as integers in the MINOR unit (paise for inr, cents for usd).
CURRENCY="inr"

# --- File uploads (Cloudinary) ---
# Needed for NGO logos, cover images, gallery pictures, team photos and legal
# documents. Without all three the app still runs, but every upload endpoint
# answers 503 and the dashboard shows uploads as unavailable.
# Free account: https://cloudinary.com — the values are on the dashboard home.
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."

# --- AI assistance (Google Gemini) ---
# Powers proposal summaries, pre-submission checks and grant matching.
# Without a key the app runs normally and those endpoints answer 503, so the
# features simply don't appear in the UI.
#
# Free, no credit card: https://aistudio.google.com/apikey
# GEMINI_API_KEY="..."
#
# Left as the `-latest` alias on purpose: free-tier quota is granted per model
# and Google retires pinned versions often. Override only to pin a version.
# GEMINI_MODEL="gemini-flash-latest"
